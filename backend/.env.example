# ── App ──────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind@localhost:5432/opsmind

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Orchestrator ─────────────────────────────────────────────────────────────
ORCHESTRATOR=docker           # or kubernetes
# K8S_IN_CLUSTER=false
# K8S_KUBECONFIG_PATH=~/.kube/config
# K8S_NAMESPACE=opsmind-labs
